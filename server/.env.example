# Server-only settings. Never put credentials in VITE_* variables.
# Choose a larger model from your OpenAI-compatible provider.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=

# Optional Brave Search API key for broad web search. Destination background
# research through Wikipedia works without this key; it is not live availability.
BRAVE_SEARCH_API_KEY=

PLANNER_PORT=8787
PLANNER_ALLOWED_ORIGIN=http://localhost:5173
# Production uses PORT and 0.0.0.0; Render supplies PORT/RENDER_EXTERNAL_URL.
# Omit PLANNER_ALLOWED_ORIGIN on Render to use RENDER_EXTERNAL_URL automatically.
# Production planner access requires both secrets below. Do not put them in VITE_*.
DEMO_ACCESS_PASSWORD=
SESSION_SECRET=
PLANNER_MAX_REQUESTS_PER_HOUR=30
# Demo access password must have at least 16 characters; session secret at least 32.
# In-memory limits are per instance and reset on restart; also cap usage at provider.
